{
  "name": "seguimiento-lamdera",
  "version": "1.0.0",
  "description": "Seguimiento con Elm, Lamdera y Tailwind CSS.",
  "main": "index.js",
  "scripts": {
    "start": "run-pty % lamdera live % tailwindcss -i ./src/styles.css -o ./public/styles.css --watch",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css",
    "check": "lamdera check",
    "audit": "npm audit --audit-level=low"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "run-pty": "^4.1.0"
  },
  "overrides": {
    "postcss": "8.5.30",
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rolojf/Seguimiento.git"
  },
  "allowScripts": {
    "node-pty@1.0.0": true
  }
}
